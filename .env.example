# jobops configuration

# Network
JOBOPS_PORT=7891
JOBOPS_HOST=127.0.0.1

# Auth — bearer token gating /mcp, /files/*, and the dashboard (all carry PII).
# Leave empty for localhost-only use (frictionless). REQUIRED to bind non-localhost:
# with JOBOPS_HOST != 127.0.0.1 and no token, the server refuses to start (default-deny).
# Generate one with:  openssl rand -hex 32
JOBOPS_AUTH_TOKEN=

# Project root — where cv.md, config/profile.yml, portals.yml live.
# Defaults to the directory this server runs from.
# To reuse the existing career-ops/ data, point it there:
# JOBOPS_PROJECT_ROOT=/Users/you/Documents/Career Ops/career-ops
JOBOPS_PROJECT_ROOT=

# Data + outputs (resolved relative to the server install dir, not project root)
JOBOPS_DATA_DIR=./data
JOBOPS_OUTPUT_DIR=./output

# Scoring — api/batch paths use MCP sampling (your connected client's model; no key) ONLY
# if the client advertises the `sampling` capability. Most clients — incl. Claude Desktop,
# as of now — do NOT, so set the BYO key below for batch/api scoring. See
# modelcontextprotocol.io/clients. Set false to always use the BYO key.
JOBOPS_SAMPLING=true

# LLM provider — BYO-key path for api/batch scoring; used whenever the client doesn't support
# sampling (the common case, incl. Claude Desktop). chat-mode (default) needs no key at all.
JOBOPS_LLM_PROVIDER=gemini     # gemini | deepseek | none
JOBOPS_LLM_MODEL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Scheduler — off by default. Enable specific jobs via scheduler_enable MCP tool.
JOBOPS_SCHEDULER_ENABLED=false

# Visa scoring — set to `false` if you don't need visa/H1B signal (US citizens, non-US
# users, etc.). When false, visa_fit is dropped from the rubric, weights renormalize to
# resume 0.6 / taste 0.4, the visa_signal / import_h1b / import_linkedin tools are hidden,
# and visa columns are stripped from tool responses. Default: true.
JOBOPS_VISA_SCORING=true

# Public URL emitted in artifact links (resume / cover / report / tracker / etc.).
# Default: http://<host>:<port> — works when client + server are on the same machine.
# Set this when the server runs on a remote host (Tailscale / LAN / cloud) so links are
# reachable from your chat machine. Examples:
#   JOBOPS_PUBLIC_BASE_URL=http://100.64.0.5:7891      # Tailscale 100.x
#   JOBOPS_PUBLIC_BASE_URL=https://jobs.example.ts.net # Tailscale magic DNS
#   JOBOPS_PUBLIC_BASE_URL=https://jobs.example.com    # reverse proxy
# Malformed values warn but do not crash the server (falls back to default).
JOBOPS_PUBLIC_BASE_URL=

# Templates (resume + cover letter themes).
# Bundled themes live under the package's templates/themes/<name>/. You can author
# your own themes in any directory and point JOBOPS_TEMPLATE_DIR at it — the
# loader checks your dir FIRST, so dropping a `default/` folder in there
# overrides the bundled default. List available themes with:
#   npx @mohith_das/jobops templates
# Each theme contains resume.tex, cover.tex, resume.html, cover.html (any subset).
# See TEMPLATES.md for the placeholder contract a custom theme must satisfy.
JOBOPS_TEMPLATE_DIR=
# Theme used when render_pdf is called without an explicit `template` argument.
JOBOPS_DEFAULT_TEMPLATE=default

# Playwright — usually no config needed once `npm run playwright:install` is done.

# ── Federation (LivingCV + HireBridge) ────────────────────────────────────────
# JobOps operates as a private edge-intelligence node in a federated talent network.
# These vars configure the connections to LivingCV (personal relay) and HireBridge (central router).
# Both endpoints follow the Canonical Federation Contract v1 — see README.

# LivingCV Master Relay — where the canonical career-packet.json lives.
# No default; you must point this at your deployed LivingCV base URL.
# The relay is an MCP SSE server at <URL>/mcp-admin/sse; sync_to_livingcv calls
# the `sync_career_packet` tool with {packet: <LcvPacket>}.
# Preconditions on the LivingCV side (Admin → Settings → MCP):
#   - mcp.enabled = 1
#   - mcp.jobops_sync_enabled = 1
# JOBOPS_LIVINGCV_TOKEN is LivingCV's master-relay bearer key
# (Admin → Settings → MCP → mcp.master_key), NOT a user JWT.
JOBOPS_LIVINGCV_URL=
JOBOPS_LIVINGCV_TOKEN=

# HireBridge central router — signal broadcast endpoint for opportunity matching.
# Default: https://api.hirebridge.io
# Set JOBOPS_HIREBRIDGE_TOKEN via `jobops connect_to_hirebridge` (device-auth + magic link).
# The broadcast_signal tool pushes a snapshot signed with ed25519 (a keypair is
# generated on first connect and stored in federation_state). Bearer token is
# used only for the auth header — never for signing.
JOBOPS_HIREBRIDGE_URL=https://api.hirebridge.io
JOBOPS_HIREBRIDGE_TOKEN=
JOBOPS_HIREBRIDGE_EMAIL=

# Edge embeddings — local vector generation for career-packet.json sections.
# JOBOPS_EMBEDDING_PROVIDER: 'local' (default) uses all-MiniLM-L6-v2 via @xenova/transformers
#   (model auto-downloads on first use, ~90MB, cached in node_modules/.cache/).
#   Options: 'local' | 'openai' | 'voyage' | 'none'
# JOBOPS_EMBEDDING_MODEL: model name. Default: 'all-MiniLM-L6-v2' for local provider.
#   For openai: 'text-embedding-3-small' (1536-dim) or 'text-embedding-3-large' (3072-dim).
#   For voyage: 'voyage-3-lite' (384-dim) or 'voyage-3-large' (1024-dim).
# API keys for openai/voyage providers:
OPENAI_API_KEY=
VOYAGE_API_KEY=
JOBOPS_EMBEDDING_PROVIDER=local
JOBOPS_EMBEDDING_MODEL=all-MiniLM-L6-v2
